<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>com.dealanalyzer</groupId>
  <artifactId>ai-deal-analyzer</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>AI Deal Analyzer</name>

  <properties>
    <java.version>21</java.version>
    <!-- Security fixes for CVE-2026-65182/65905/68525 beyond Boot's Tomcat 11.0.24. -->
    <tomcat.version>11.0.25</tomcat.version>
    <!-- Flyway uses Jackson 3; 3.1.7 fixes the high-severity findings in Boot's 3.1.5. -->
    <jackson-bom.version>3.1.7</jackson-bom.version>
    <!-- Jackson 2 preserves existing API and stored JSON; security patch newer than Boot's 2.21.5. -->
    <jackson-2-bom.version>2.21.7</jackson-2-bom.version>
    <!-- Bound concurrency independently of host CPU count; use 1 for serial troubleshooting. -->
    <test.forkCount>2</test.forkCount>
    <test.heapSize>2048m</test.heapSize>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>2.46.11</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
      <!-- Use the explicit synchronous transport without changing Spring RestClient auto-selection. -->
      <exclusions>
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>apache5-client</artifactId>
        </exclusion>
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>netty-nio-client</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>url-connection-client</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-mail</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-jackson2</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>pdfbox</artifactId>
      <version>3.0.8</version>
    </dependency>
    <dependency>
      <groupId>com.anthropic</groupId>
      <artifactId>anthropic-java</artifactId>
      <version>2.66.0</version>
    </dependency>
    <dependency>
      <groupId>com.openai</groupId>
      <artifactId>openai-java</artifactId>
      <version>4.72.0</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <executions>
          <execution>
            <id>prepare-test-directories</id>
            <phase>generate-test-resources</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <target>
                <!-- java.io.tmpdir must exist before a forked JVM starts. -->
                <mkdir dir="${project.build.directory}/surefire-reports"/>
                <mkdir dir="${project.build.directory}/test-forks/1/tmp"/>
                <mkdir dir="${project.build.directory}/test-forks/2/tmp"/>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <forkCount>${test.forkCount}</forkCount>
          <reuseForks>true</reuseForks>
          <argLine>-Xmx${test.heapSize} -Xlog:gc:file="${project.build.directory}/surefire-reports/gc-%p.log":uptime,level,tags -Djava.io.tmpdir="${project.build.directory}/test-forks/${surefire.forkNumber}/tmp"</argLine>
          <systemPropertyVariables>
            <junit.jupiter.execution.parallel.enabled>false</junit.jupiter.execution.parallel.enabled>
            <document.storage.path>${project.build.directory}/test-forks/${surefire.forkNumber}/objects</document.storage.path>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <execution>
            <id>default-test</id>
            <configuration>
              <excludedGroups>serial</excludedGroups>
              <!-- Reuse warm JVMs; each slot retains its own files and runs methods sequentially. -->
              <reuseForks>true</reuseForks>
            </configuration>
          </execution>
          <execution>
            <id>serial-tests</id>
            <goals><goal>test</goal></goals>
            <configuration>
              <!-- Shared PostgreSQL evidence and latency measurements need an idle test pool. -->
              <forkCount>1</forkCount>
              <groups>serial</groups>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.dealanalyzer.DealAnalyzerApplication</mainClass>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <!-- Container security probes and executable-jar checks stay sequential. -->
          <forkCount>1</forkCount>
          <reuseForks>true</reuseForks>
          <argLine>-Xmx512m -Djava.io.tmpdir="${project.build.directory}/test-forks/${surefire.forkNumber}/tmp"</argLine>
        </configuration>
        <executions>
          <execution>
            <goals><goal>integration-test</goal><goal>verify</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
