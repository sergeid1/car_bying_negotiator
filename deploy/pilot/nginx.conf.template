worker_processes 1;
error_log /dev/stderr crit;
pid /var/run/nginx.pid;
events { worker_connections 256; }
http {
  map_hash_bucket_size 128;
  access_log off;
  server_tokens off;
  client_body_temp_path /var/cache/nginx/client_temp;
  proxy_temp_path /var/cache/nginx/proxy_temp;
  limit_req_zone $binary_remote_addr zone=api:1m rate=10r/s;
  limit_req_zone $binary_remote_addr zone=upload:1m rate=1r/s;
  map $http_x_origin_verify $origin_verified {
    default 0;
    "@ORIGIN_SECRET@" 1;
  }
  # The Worker's visitor address (ticket 136) passes only on requests carrying the origin secret.
  map $origin_verified $otdog_client_address {
    default "";
    1 $http_x_otdog_client_address;
  }
  server {
    listen 443 ssl;
    ssl_certificate /run/tls.crt;
    ssl_certificate_key /run/tls.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 21m;
    client_body_timeout 30s;
    if ($origin_verified = 0) { return 403; }
    add_header Cache-Control no-store always;
    location ~ ^/api/v1/cases/[^/]+/documents {
      limit_req zone=upload burst=3 nodelay;
      include /run/otdog-proxy.inc;
    }
    location /api/ {
      limit_req zone=api burst=20 nodelay;
      include /run/otdog-proxy.inc;
    }
    location / { return 404; }
  }
}
