[Unit]
Description=OTDog pilot runtime
After=network-online.target docker.service user@10001.service
Requires=docker.service user@10001.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/otdog/deploy/pilot
EnvironmentFile=/etc/otdog-release.env
ExecStartPre=/usr/bin/python3 /opt/otdog/deploy/pilot/load-runtime.py ${AWS_REGION} ${RUNTIME_PARAMETER_NAME}
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=180
UMask=0077

[Install]
WantedBy=multi-user.target
